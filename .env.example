# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. .env.local is git-ignored.
# ---------------------------------------------------------------------------
#
# The first admin account is seeded from these values the first time the app
# runs in a browser. There is deliberately NO password here — only a random
# salt and a PBKDF2-SHA256 digest, which cannot be turned back into a password.
#
# Generate a matching set with:
#
#     node scripts/make-admin-hash.mjs
#
# Vite inlines every VITE_* variable into the built JavaScript, so treat the
# digest as public. It is safe to publish; a password would not be.
#
VITE_INITIAL_ADMIN_USERNAME=
VITE_INITIAL_ADMIN_NAME=
VITE_INITIAL_ADMIN_SALT=
VITE_INITIAL_ADMIN_HASH=
VITE_INITIAL_ADMIN_ITERATIONS=210000
